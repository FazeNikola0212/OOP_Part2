<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.PasswordField?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.CreateUserController">

    <Label fx:id="headingLabel"
           alignment="CENTER"
           layoutX="61.0"
           layoutY="25.0"
           prefHeight="64.0"
           prefWidth="992.0"
           text="User Creating"
           AnchorPane.leftAnchor="61.0"
           AnchorPane.rightAnchor="9.4">
        <font>
            <Font name="Times New Roman" size="31.0"/>
        </font>
    </Label>

    <Label alignment="CENTER" layoutX="565.0" layoutY="137.0"
           prefHeight="18.0" prefWidth="200.0"
           text="Username"/>

    <TextField fx:id="usernameField"
               layoutX="566.0" layoutY="156.0"
               prefWidth="200.0">
        <cursor>
            <Cursor fx:constant="HAND"/>
        </cursor>
    </TextField>

    <Label alignment="CENTER" layoutX="564.0" layoutY="188.0"
           prefHeight="18.0" prefWidth="200.0"
           text="Password"/>

    <PasswordField fx:id="passwordField"
                   layoutX="565.0" layoutY="206.0"
                   prefWidth="200.0">
        <cursor>
            <Cursor fx:constant="HAND"/>
        </cursor>
    </PasswordField>

    <Label alignment="CENTER" layoutX="564.0" layoutY="239.0"
           prefHeight="18.0" prefWidth="200.0"
           text="Email"/>

    <TextField fx:id="emailField"
               layoutX="565.0" layoutY="257.0"
               prefWidth="200.0">
        <cursor>
            <Cursor fx:constant="HAND"/>
        </cursor>
    </TextField>

    <Label alignment="CENTER" layoutX="564.0" layoutY="292.0"
           prefHeight="18.0" prefWidth="200.0"
           text="Role"/>

    <ChoiceBox fx:id="roleChoiceBox"
               layoutX="565.0" layoutY="311.0"
               prefHeight="30.0" prefWidth="200.0">
        <cursor>
            <Cursor fx:constant="HAND"/>
        </cursor>
    </ChoiceBox>

    <Label alignment="CENTER" layoutX="564.0" layoutY="353.0"
           prefHeight="18.0" prefWidth="200.0"
           text="Full Name"/>

    <TextField fx:id="fullnameField"
               layoutX="565.0" layoutY="372.0"
               prefWidth="200.0">
        <cursor>
            <Cursor fx:constant="HAND"/>
        </cursor>
    </TextField>

    <Button layoutX="602.0" layoutY="430.0"
            mnemonicParsing="false"
            onAction="#createUser"
            prefHeight="37.0"
            prefWidth="126.0"
            text="Create">
        <cursor>
            <Cursor fx:constant="HAND"/>
        </cursor>
    </Button>

    <Button fx:id="backBtn"
            layoutX="147.0"
            layoutY="42.0"
            mnemonicParsing="false"
            onAction="#goBack"
            prefHeight="30.0"
            prefWidth="70.0"
            text="Back"
            AnchorPane.leftAnchor="147.0">
        <cursor>
            <Cursor fx:constant="HAND"/>
        </cursor>
    </Button>

    <Button fx:id="logoutBtn"
            layoutX="1060.0"
            layoutY="42.0"
            mnemonicParsing="false"
            onAction="#logout"
            prefHeight="30.0"
            prefWidth="70.0"
            text="Logout"
            AnchorPane.rightAnchor="147.0">
        <cursor>
            <Cursor fx:constant="HAND"/>
        </cursor>
    </Button>

</AnchorPane>
